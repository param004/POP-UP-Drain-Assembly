# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/pop-up-drain

# --- Auth ---
# Generate a real secret for production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed origins.
CLIENT_URL=http://localhost:5173

# --- Seed admin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@premierproducts.com
SEED_ADMIN_PASSWORD=Admin123!

# --- Contact form SMTP (optional; messages are stored even when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
