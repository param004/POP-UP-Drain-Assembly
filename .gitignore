# Dependencies — reinstalled by `npm install` / ./start.sh
node_modules/
.pnp
.pnp.js

# Build output — regenerated by `vite build` and `npm run build` in server/
dist/
build/
*.tsbuildinfo

# Secrets. server/.env holds the real JWT_SECRET, seed admin password, Mongo URI
# and SMTP credentials, so it must never be committed — .env.example is the
# committed template.
.env
.env.*
!.env.example

# Logs, including the start.sh / launchd output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS cruft
.DS_Store
Thumbs.db

# Editors and tooling
.vscode/
.idea/
*.swp
*.swo
*~

# OS caches
.cache/
.eslintcache
.oxlintrc.local.json

# Local scratch
tmp/
temp/
*.local
